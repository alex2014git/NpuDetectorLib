#!/bin/bash
# Pre-commit validation hook
# Runs cmake build and test executable to validate changes before committing

set -e

echo "Running pre-commit validation..."

# Step 1: Configure cmake
echo "Configuring cmake..."
cmake -S . -Bbuild -DBUILD_TESTER=ON -DTIME_TRACE_DEBUG=ON

# Step 2: Rebuild
echo "Building project..."
cmake --build build
if [ $? -ne 0 ]; then
    echo "Build failed! Commit blocked."
    exit 1
fi

# Step 3: Run base test
echo "Running base test (yolov5s)..."
./build/tests/TestExecutable -i 2.jpg
if [ $? -ne 0 ]; then
    echo "Base test failed! Commit blocked."
    exit 1
fi

# Step 4: Run YOLOv8 pose test
echo "Running YOLOv8 pose test..."
./build/tests/TestExecutable -i 2.jpg -a yolov8_pose -m models/yolov8s_pose.json
if [ $? -ne 0 ]; then
    echo "YOLOv8 pose test failed! Commit blocked."
    exit 1
fi

# Step 5: Run YOLOv8 segmentation test
echo "Running YOLOv8 segmentation test..."
./build/tests/TestExecutable -i 2.jpg -a yolov8_seg -m models/yolov8s_seg.json
if [ $? -ne 0 ]; then
    echo "YOLOv8 segmentation test failed! Commit blocked."
    exit 1
fi

echo "Validation passed!"
exit 0
