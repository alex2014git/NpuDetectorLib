#!/bin/bash
set -e

echo "=== Pre-commit Validation ==="

# 1. Configure - MUST include both flags for validation tests
echo "[1/15] Configuring cmake..."
cmake -S . -Bbuild -DBUILD_TESTER=ON -DBUILD_VALIDATION_TESTS=ON

# 2. Build
echo "[2/15] Building project..."
cmake --build build

# 3. yolov5s test
echo "[3/15] Running yolov5s test..."
./build/tests/TestExecutable -i 2.jpg

# 4. yolov8s detection test
echo "[4/15] Running yolov8s detection test..."
./build/tests/TestExecutable -i 2.jpg -a yolov8 -m models/yolov8s.json

# 5. yolov8_pose test
echo "[5/15] Running yolov8_pose test..."
./build/tests/TestExecutable -i 2.jpg -a yolov8_pose -m models/yolov8s_pose.json

# 6. yolov8_seg test
echo "[6/15] Running yolov8_seg test..."
./build/tests/TestExecutable -i 2.jpg -a yolov8_seg -m models/yolov8s_seg.json

# 7. TestModelLoading
echo "[7/15] Running TestModelLoading..."
./build/tests/TestModelLoading

# 8. TestSingleInference
echo "[8/15] Running TestSingleInference..."
./build/tests/TestSingleInference

# 9. TestThreadSafety
echo "[9/15] Running TestThreadSafety..."
./build/tests/TestThreadSafety

# 10. TestAsyncBackend
echo "[10/15] Running TestAsyncBackend..."
./build/tests/TestAsyncBackend

# 11. TestFactoryMapping
echo "[11/15] Running TestFactoryMapping..."
./build/tests/TestFactoryMapping

# 12. TestPipelineLpr
echo "[12/15] Running TestPipelineLpr..."
./build/tests/TestPipelineLpr

# 13. TestLprClassification
echo "[13/15] Running TestLprClassification..."
./build/tests/TestLprClassification

# 14. TestLprDecoder
echo "[14/15] Running TestLprDecoder..."
./build/tests/TestLprDecoder

# 15. TestClassificationDecoder
echo "[15/15] Running TestClassificationDecoder..."
./build/tests/TestClassificationDecoder

echo "=== All validation passed! ==="
exit 0
